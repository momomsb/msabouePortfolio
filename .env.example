# Copy to .env.local for local development, and set the same keys in
# Vercel → Project → Settings → Environment Variables. Never commit real values.

# ── Public (exposed to the browser: no secrets here) ──────────────
# Canonical URL used for metadata, sitemap and JSON-LD.
# Optional on Vercel (falls back to VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Server only ───────────────────────────────────────────────────
# "Ask my AI": without a key the assistant runs in demo mode
# (deterministic answers built from data/).
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
ANTHROPIC_MODEL=

# Contact form delivery via Resend (https://resend.com).
# Without these, /api/contact answers "not configured" and the form says so.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Must be a sender on a domain verified in Resend, e.g. "Portfolio <contact@your-domain.com>".
CONTACT_FROM_EMAIL=
